// Safeship data model (§6 of BUILD.md)
// Postgres (Supabase) — durable, multi-user, and works on Vercel serverless.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled (PgBouncer, port 6543) connection used by the app.
  url       = env("DATABASE_URL")
  // Direct connection (port 5432) used only for migrations.
  directUrl = env("DIRECT_URL")
}

model User {
  id            String         @id @default(cuid())
  githubId      String         @unique
  username      String
  email         String?
  accessToken   String // GitHub OAuth token — kept server-side only, never logged
  createdAt     DateTime       @default(now())
  // "Bring your own model" — a library of the user's OpenAI-compatible models
  // (keys stored encrypted), plus which model each AI feature uses. A null
  // assignment means Safeship's built-in default.
  llmModels        LlmModel[]
  explainModelId   String?
  advisorModelId   String?
  assistantModelId String?
  fixModelId       String?
  scans         Scan[]
  advisorRuns   AdvisorRun[]
  conversations Conversation[]
  watchedRepos  WatchedRepo[]
}

// A repo the user asked Safeship to re-scan automatically on a schedule, so its
// safety score stays current without them remembering to click Scan.
model WatchedRepo {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  repoFullName String
  repoUrl      String
  createdAt    DateTime @default(now())

  @@unique([userId, repoFullName])
  @@index([userId])
}

// One saved OpenAI-compatible model connection. The API key is encrypted
// (AES-256-GCM) and never returned to the client.
model LlmModel {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  provider  String
  baseUrl   String
  model     String
  apiKeyEnc String
  createdAt DateTime @default(now())

  @@index([userId])
}

model Scan {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  repoFullName String // e.g. "octocat/hello-world"
  repoUrl      String
  status       String    @default("queued") // queued | running | done | failed
  score        Int? // 0-100 overall safety score, computed from findings
  error        String?
  /// Append-only progress events: [{ "key": "cloning", "at": "2026-01-01T00:00:00Z" }]
  steps        Json?
  // Opt-in read-only public sharing. Null token = private (the default). A random
  // token is minted when the owner chooses to share, and cleared to revoke.
  shareToken   String?   @unique
  sharedAt     DateTime?
  createdAt    DateTime  @default(now())
  finishedAt   DateTime?
  findings     Finding[]
}

model Finding {
  id               String   @id @default(cuid())
  scanId           String
  scan             Scan     @relation(fields: [scanId], references: [id])
  engine           String // gitleaks | semgrep | osv
  ruleId           String
  severity         String // critical | high | medium | low (normalized)
  priority         String // fix_now | should_fix | minor (LLM-assigned)
  title            String // short, plain-language title
  filePath         String?
  line             Int?
  rawMessage       String // engine's original message
  plainExplanation String? // LLM: what it means, for a non-expert
  suggestedFix     String? // LLM: how to fix it (snippet or steps)
  redacted         Boolean  @default(false) // true if we scrubbed a secret value
  // Dismissal — a user can mark a finding as a false positive / accepted risk so
  // it drops out of the active report and stays quiet on future re-scans.
  dismissed        Boolean  @default(false)
  dismissReason    String? // false_positive | accepted_risk | wont_fix
  dismissedAt      DateTime?
  createdAt        DateTime @default(now())
}

// A saved Advisor review so users can see recent activity and reopen results.
model AdvisorRun {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  repoFullName    String
  tool            String // schema | stack | optimize
  rating          String // good | fair | poor
  headline        String
  markdown        String
  /// Parsed ER-diagram model (schema tool only).
  model           Json?
  /// string[] of file paths the review read.
  filesConsidered Json?
  createdAt       DateTime @default(now())

  @@index([userId, createdAt])
}

// A saved Assistant chat, so conversations persist across sessions.
model Conversation {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  title     String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]

  @@index([userId, updatedAt])
}

model ChatMessage {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // user | assistant
  content        String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}
